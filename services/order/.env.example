PORT=4002
# fluxo local (bun run dev), fora do docker-compose: tudo aponta para
# localhost, já que os containers de postgres/rabbitmq/keycloak publicam
# suas portas no host.
DATABASE_URL=postgresql://admin:admin@localhost:5432/order
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# ISSUER usa localhost: precisa bater com o "iss" DENTRO do token,
# e o token foi emitido para o browser, que acessa via localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/mini-food
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/mini-food/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=mini-food-client
