PORT=4004
# host "postgres", não "localhost" — é o nome do serviço na rede Docker
DATABASE_URL=postgresql://admin:admin@postgres:5432/auth
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# ISSUER usa localhost: precisa bater com o "iss" DENTRO do token,
# e o token foi emitido para o browser, que acessa via localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/mini-food
# JWKS usa o host interno: quem busca as chaves é o SERVIÇO, de dentro do Docker
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/mini-food/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=mini-food-client

# INTERNAL_URL/ADMIN_URL: host que o PROCESSO do auth-service alcança.
# rodando localmente (bun run) -> localhost; rodando dentro do Docker -> keycloak
KEYCLOAK_INTERNAL_URL=http://localhost:8080/realms/mini-food
KEYCLOAK_ADMIN_URL=http://localhost:8080/admin/realms/mini-food
# client confidencial com service account (role manage-users em realm-management)
KEYCLOAK_ADMIN_CLIENT_ID=auth-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=auth-service-secret

# usada para cifrar o refresh token guardado durante o desafio de 2FA
TWO_FACTOR_TOKEN_SECRET=dev-only-two-factor-secret-change-me
APP_URL=http://localhost:3000